#!/bin/bash
# Simulated Claude Code CLI: plugins and login, with state in $ZEUS_SIM_STATE.
S="$ZEUS_SIM_STATE"
case "${1:-}" in
  plugin)
    case "${2:-}" in
      list)
        echo "Installed plugins:"
        for f in "$S"/plugin-*; do [ -f "$f" ] && printf '\n  ❯ %s\n    Scope: user\n' "$(cat "$f")"; done
        ;;
      install)
        name="$3"
        echo "$name" >"$S/plugin-${name//[@\/]/_}"
        if [[ "$name" == zeus-editor@* ]]; then
          dist="$HOME/.claude/plugins/cache/zeus-editor/zeus-editor/sim/dist"
          mkdir -p "$dist"
          cp "$ZEUS_SIM_PAYLOAD/zeus.mjs" "$dist/zeus.mjs"
        fi
        echo "✔ Installed $name (simulated)"
        ;;
      *) echo "ok (simulated)" ;;
    esac
    ;;
  auth)
    case "${2:-}" in
      status)
        if [ -f "$S/claude-login" ]; then printf '{\n  "loggedIn": true\n}\n'; exit 0; fi
        printf '{\n  "loggedIn": false\n}\n'
        exit 1
        ;;
      login)
        echo "Opening browser to sign in…"
        echo "If the browser didn't open, visit: https://claude.ai/oauth/authorize?simulated=1"
        sleep 4
        touch "$S/claude-login"
        echo "Login successful."
        ;;
    esac
    ;;
  --version) echo "2.1.322 (Claude Code, simulated)" ;;
  *) echo "claude (simulated): $*" ;;
esac
