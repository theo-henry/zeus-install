#!/bin/bash
# Simulated Google Cloud CLI (the installer puts it in ~/google-cloud-sdk/bin). Each call is logged in
# $ZEUS_SIM_STATE/gcloud.log. "auth application-default login" writes the credentials file and ends the simulated
# EU sign-in problem ($ZEUS_SIM_STATE/eu-preflight), as a real sign-in does. Nothing reaches Google.
# $ZEUS_SIM_STATE/eu-quota-denied, or $ZEUS_SIM_STATE/google-access "none" (see stubs/curl), is an account without the
# Service Usage Consumer role: set-quota-project fails with the words of real gcloud.
# $ZEUS_SIM_STATE/google-token-expired makes print-access-token fail, as an expired sign-in.
S="$ZEUS_SIM_STATE"
ADC="$HOME/.config/gcloud/application_default_credentials.json"
printf '%s\n' "$*" >>"$S/gcloud.log"
case "$*" in
  "--version") echo "Google Cloud SDK 593.0.0 (simulated)" ;;
  config\ set*) exit 0 ;;
  "auth application-default login")
    echo "Your browser has been opened to visit:"
    echo "    https://accounts.google.com/o/oauth2/auth?simulated=1"
    sleep 1
    if [ -f "$S/eu-sign-in-fails" ]; then echo "ERROR: (gcloud.auth.application-default.login) simulated failure" >&2; exit 1; fi
    mkdir -p "$HOME/.config/gcloud"
    printf '{"type": "authorized_user", "simulated": true}\n' >"$ADC"
    rm -f "$S/eu-preflight" "$S/google-token-expired"
    echo "Credentials saved to file: [$ADC]"
    ;;
  "auth application-default print-access-token")
    if [ ! -f "$ADC" ] || [ -f "$S/google-token-expired" ]; then
      echo "ERROR: (gcloud.auth.application-default.print-access-token) Reauthentication failed. (simulated)" >&2
      exit 1
    fi
    echo "sim-access-token"
    ;;
  "auth application-default set-quota-project "*)
    project="${!#}"
    if [ -f "$S/eu-quota-denied" ] || [ "$(cat "$S/google-access" 2>/dev/null)" = none ]; then
      printf 'ERROR: (gcloud.auth.application-default.set-quota-project) Cannot add the project "%s" to application default credentials (ADC) as a quota project because the account in ADC does not have the "serviceusage.services.use" permission on this project.\n' "$project" >&2
      exit 1
    fi
    if [ -f "$ADC" ]; then
      python3 -c 'import json, sys; c = json.load(open(sys.argv[1])); c["quota_project_id"] = sys.argv[2]; json.dump(c, open(sys.argv[1], "w"))' "$ADC" "$project"
    fi
    echo "Quota project \"$project\" was added to ADC (simulated)."
    ;;
  *) echo "gcloud (simulated): $*" ;;
esac
